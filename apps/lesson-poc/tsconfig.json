{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2022",
    "types": ["svelte", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "sysdiag-ui-kit": ["../../libs/src/lib/index.ts"],
